# 复制为 ~/k8s-fault-lab/lab.env 后修改；使用前:
#   set -a; source ~/k8s-fault-lab/lab.env; set +a
# 不要把凭据写进这个文件。

# kubeconfig / context（可选；默认使用当前 kubectl context）
# ADMIN_KUBECONFIG=$HOME/.kube/config
# ADMIN_CONTEXT=

# 演练命名空间默认 training-lab；如需改名，修改脚本和清单中的 NS

# 镜像（默认公开镜像；集群不能访问 docker.io 时改成内部镜像）
# LAB_IMAGE=python:3.10-slim
# LAB_PAUSE_IMAGE=registry.k8s.io/pause:3.9
# LAB_REGISTRY=docker.io

# Ingress 控制器位置（默认 ingress-nginx 命名空间）
# INGRESS_NS=ingress-nginx
# INGRESS_SVC=ingress-nginx-controller
# registry-tls 场景需要一个证书不含 IP SAN 的 HTTPS 入口 IP
# LAB_TLS_IP=10.0.0.100

# 节点 SSH 模式: direct（本机直连，默认）或 jump（跳板机）
NODE_SSH_MODE=direct

# --- 直连模式 ---
NODE_SSH_KEY=$HOME/.ssh/id_rsa
NODE_SSH_PORT=22
NODE_SSH_USER=root
TRAIN_NODE=10.0.0.10

# --- 跳板机模式（把 NODE_SSH_MODE 改成 jump）---
# JUMP_HOST=203.0.113.10
# JUMP_PORT=22
# JUMP_USER=root
# JUMP_KEY=$HOME/.ssh/id_rsa
# TRAIN_NODE=10.0.0.10
