}

scenario_service_port() {
  k apply -f - >/dev/null <<EOF
apiVersion: v1
kind: Service
metadata:
  name: lab-web-badport
  namespace: $NS
spec:
  selector: {app: lab-web}
  ports:
    - port: 80
      targetPort: 9999
EOF
  echo "已注入: Service targetPort 指向 9999（容器监听 8080），预期连接拒绝。"
  k get endpoints lab-web-badport -n "$NS" 2>/dev/null || true
  echo -n "从 lab-client 访问结果: "
  k exec deploy/lab-client -n "$NS" -- python3 -c \
    "import urllib.request;print(urllib.request.urlopen('http://lab-web-badport.$NS.svc.cluster.local/',timeout=3).status)" 2>&1 | tail -1
  cat <<EOF
排查路径:
  kubectl get svc lab-web-badport -n $NS -o yaml
  kubectl get endpoints lab-web-badport -n $NS
  kubectl exec deploy/lab-client -n $NS -- python3 -c "import urllib.request;print(urllib.request.urlopen('http://lab-web-badport/').status)"
EOF
}

scenario_readiness_fail() {
  k apply -f - >/dev/null <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: smoke-readiness
  namespace: $NS
  labels: {app: smoke-readiness}
spec:
  replicas: 1
  selector:
    matchLabels: {app: smoke-readiness}
  template:
    metadata:
      labels: {app: smoke-readiness}
    spec:
          containers:
        - name: app
          image: $IMG
          imagePullPolicy: IfNotPresent
          command: ["python3", "-m", "http.server", "8080"]
          readinessProbe:
            httpGet: {path: /healthz, port: 8080}
            periodSeconds: 5
            failureThreshold: 2
          resources:
            requests: {cpu: 1m, memory: 8Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: smoke-readiness
  namespace: $NS
spec:
  selector: {app: smoke-readiness}
  ports:
    - port: 80
      targetPort: 8080
EOF
  echo "已注入: readinessProbe 访问不存在的 /healthz，预期 Pod Running 0/1、Endpoints 为空。"
  sleep 14
  k get pod -l app=smoke-readiness -n "$NS" 2>/dev/null || true
  k get endpoints smoke-readiness -n "$NS" 2>/dev/null || true
  cat <<EOF
排查路径:
  kubectl describe pod -l app=smoke-readiness -n $NS | grep -A5 -i readiness
  kubectl get endpoints smoke-readiness -n $NS
  kubectl logs deploy/smoke-readiness -n $NS
EOF
}

recover_one() {
  local s="$1"
  case "$s" in
    ingress-backend) k delete ingress lab-ingress-bad -n "$NS" --ignore-not-found ;;
    ingress-class)   k delete ingress lab-ingress-class -n "$NS" --ignore-not-found ;;
    ingress-tls)     k delete ingress lab-tls -n "$NS" --ignore-not-found; k delete secret lab-tls -n "$NS" --ignore-not-found ;;
    cert-bad|cert-expired|cert-missing)
      k delete ingress lab-tls -n "$NS" --ignore-not-found
      k delete secret lab-tls -n "$NS" --ignore-not-found ;;
    registry-unreachable) k delete pod smoke-registry -n "$NS" --ignore-not-found --wait=false ;;
    image-not-found)      k delete pod smoke-image-404 -n "$NS" --ignore-not-found --wait=false ;;
    image-bad-digest)     k delete pod smoke-image-digest -n "$NS" --ignore-not-found --wait=false ;;
    registry-dns)         k delete pod smoke-registry-dns -n "$NS" --ignore-not-found --wait=false ;;
    registry-auth)        k delete pod smoke-registry-auth -n "$NS" --ignore-not-found --wait=false ;;
    registry-tls)         k delete pod smoke-registry-tls -n "$NS" --ignore-not-found --wait=false ;;
    registry-timeout)     k delete pod smoke-registry-timeout -n "$NS" --ignore-not-found --wait=false ;;
    image-invalid-ref)    k delete pod smoke-image-invalid -n "$NS" --ignore-not-found --wait=false ;;
    pullsecret-missing)   k delete pod smoke-pullsecret -n "$NS" --ignore-not-found --wait=false ;;
    oom-killed)           k delete pod smoke-oom -n "$NS" --ignore-not-found --wait=false ;;
    crashloop)            k delete pod smoke-crashloop -n "$NS" --ignore-not-found --wait=false ;;
    pvc-pending)          k delete pod smoke-pvc-pod -n "$NS" --ignore-not-found --wait=false; k delete pvc smoke-pvc -n "$NS" --ignore-not-found ;;
    quota-exceeded)       k delete pod smoke-quota -n "$NS" --ignore-not-found ;;
    unschedulable)        k delete pod smoke-unschedulable -n "$NS" --ignore-not-found --wait=false ;;
    configmap-missing)    k delete pod smoke-configmap -n "$NS" --ignore-not-found --wait=false ;;
    service-port)         k delete svc lab-web-badport -n "$NS" --ignore-not-found ;;
    readiness-fail)       k delete deploy smoke-readiness -n "$NS" --ignore-not-found; k delete svc smoke-readiness -n "$NS" --ignore-not-found ;;
    *) echo "未知场景: $s" >&2; return 1 ;;
  esac
  echo "已恢复: $s"
}

scenario_status() {
  echo "=== Pods ==="; k get pods -n "$NS" -o wide 2>&1
  echo "=== Ingress ==="; k get ingress -n "$NS" 2>&1
  echo "=== PVC ==="; k get pvc -n "$NS" 2>&1
  echo "=== Quota ==="; k get resourcequota -n "$NS" 2>&1
  echo "=== 最近事件 ==="; k get events -n "$NS" --sort-by=.lastTimestamp 2>&1 | tail -15
}

usage() {
  cat <<EOF
用法: $0 <command> [scenario]

场景:
  ingress-backend      Ingress 后端端口写错（503）
  ingress-class        IngressClass 不存在（创建了但不生效）
  ingress-tls          创建正常 TLS Ingress（前置）
  cert-bad             替换为域名不匹配证书
  cert-expired         替换为过期证书
  cert-missing         删除 TLS Secret
  registry-unreachable 镜像仓库不可达（ImagePullBackOff）
  image-not-found      镜像 Tag 不存在（manifest not found）
  image-bad-digest     镜像 digest 写错（not found）
  registry-dns         仓库域名解析失败（no such host）
  registry-auth        私有仓库未授权（401）
  registry-tls         仓库证书校验失败（x509 / IP SAN）
  registry-timeout     仓库连接超时（connection timed out）
  image-invalid-ref    镜像名格式非法（InvalidImageName）
  pullsecret-missing   imagePullSecrets 缺失
  oom-killed           容器内存超限 OOMKilled
  crashloop            启动即退出 CrashLoopBackOff
  pvc-pending          StorageClass 不存在，PVC/Pod Pending
  quota-exceeded       超出 ResourceQuota
  unschedulable        nodeSelector 无匹配节点
  configmap-missing    ConfigMap 不存在
  service-port         Service targetPort 错误
  readiness-fail       就绪探针失败，Endpoints 为空

命令:
  list                 列出场景
  status               查看 $NS 资源
  inject <scenario>    注入
  recover <scenario|all> 恢复
  verify <scenario>    仅打印该场景排查路径（注入时会自动打印）
EOF
}

SCENARIOS="ingress-backend ingress-class ingress-tls cert-bad cert-expired cert-missing registry-unreachable image-not-found image-bad-digest registry-dns registry-auth registry-tls registry-timeout image-invalid-ref pullsecret-missing oom-killed crashloop pvc-pending quota-exceeded unschedulable configmap-missing service-port readiness-fail"

cmd="${1:-help}"
case "$cmd" in
  list) echo "$SCENARIOS" | tr ' ' '\n' ;;
  status) scenario_status ;;
  inject)
    s="${2:-}"
    case "$s" in
      ingress-backend) scenario_ingress_backend ;;
      ingress-class) scenario_ingress_class ;;
      ingress-tls) scenario_ingress_tls ;;
      cert-bad) scenario_cert_bad ;;
      cert-expired) scenario_cert_expired ;;
      cert-missing) scenario_cert_missing ;;
      registry-unreachable) scenario_registry_unreachable ;;
      image-not-found) scenario_image_not_found ;;
      image-bad-digest) scenario_image_bad_digest ;;
      registry-dns) scenario_registry_dns ;;
      registry-auth) scenario_registry_auth ;;
      registry-tls) scenario_registry_tls ;;
      registry-timeout) scenario_registry_timeout ;;
      image-invalid-ref) scenario_image_invalid_ref ;;
      pullsecret-missing) scenario_pullsecret_missing ;;
      oom-killed) scenario_oom_killed ;;
      crashloop) scenario_crashloop ;;
      pvc-pending) scenario_pvc_pending ;;
      quota-exceeded) scenario_quota_exceeded ;;
      unschedulable) scenario_unschedulable ;;
      configmap-missing) scenario_configmap_missing ;;
      service-port) scenario_service_port ;;
      readiness-fail) scenario_readiness_fail ;;
      *) echo "未知场景: ${s:-<空>}"; usage; exit 1 ;;
    esac ;;
  recover)
    s="${2:-}"
    if [ "$s" = "all" ]; then
      for x in $SCENARIOS; do recover_one "$x" || true; done
    else
      recover_one "$s"
    fi ;;
  verify) echo "注入时会自动打印排查路径；也可参考 README 的场景表。" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
