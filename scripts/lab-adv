      image: $IMG
      imagePullPolicy: IfNotPresent
      command: ["sleep", "3600"]
      resources:
        requests: {cpu: 1m, memory: 8Mi}
EOF
  echo "已注入: nodeSelector 指向不存在的标签，预期 Pending。"
  k get pod smoke-unschedulable -n "$NS" 2>/dev/null || true
  cat <<EOF
排查路径:
  kubectl describe pod smoke-unschedulable -n $NS | tail -15
  kubectl get nodes --show-labels | grep training
  典型事件: 0/8 nodes are available
EOF
}

